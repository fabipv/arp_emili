#
# EMILI hook-run ver 1.7 for irace 1.07
#
# changelog:
#
# ver 1.7
#     - removed the swap between STDOUT and STDERR, now they are redirected to two temp files
# ver 1.6a
#     - fixed the if that checks if the value returned by EMILI is a number	
# ver 1.6
#     - added retry mechanism
# ver 1.5
#     - added error reporting
# ver 1.0
#     - changed from "compile and run" to "parse and run"

#export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/lustre/home/mascia/software/lib:/lustre/home/mascia/software/lib64
INSTANCE=$4
INSTANCEID=$2
RND_SEED=$3
CANDNUM=$1
shift 4
PARAMS=$*
TRIES=3
OUTPUT="/dev/null"
GRAMMAR2CODE="/home/pcontreras/emili/emili_vrp/grammar2code"
EMILI_SRC="/home/pcontreras/emili/emili_vrp/"
#GRAMMAR_DIR="$EMILI_SRC/grammar3p.xml"
#GRAMMAR_DIR="$EMILI_SRC/jdpfsp-ms-3s.xml"
#GRAMMAR_DIR="$EMILI_SRC/grammars/pfsp-ms-3simple.xml"
GRAMMAR_DIR='/home/pcontreras/emili/emili_vrp/cvrp_grammar.xml'
ERR_OUT='/home/pcontreras/emili/emili_vrp/ERROR'
BUILD_DIR=`mktemp -d`
TIMER_SETTING='-ro 0.03'
#cp $EMILI_SRC/* $BUILD_DIR 2> $OUTPUT 1> $OUTPUT
$GRAMMAR2CODE $GRAMMAR_DIR -t $BUILD_DIR $PARAMS 1>> $OUTPUT 2>> $OUTPUT
HOST_NAME=`hostname`
pushd $BUILD_DIR  1>> $OUTPUT
PARAMETERS=`cat params`
STDOUT=`mktemp`
STDERR=`mktemp`
EMILI_BIN='/home/fpagnozzi/emili/build/EMILI'
$EMILI_BIN $INSTANCE $PARAMETERS $TIMER_SETTING rnds $RND_SEED 1> $STDOUT 2> $STDERR
OUT_VALUE=`cat $STDERR | tail -n1`
if echo "$OUT_VALUE" | grep -Eq "^[0-9]+(\.[0-9]+([eE][+-][0-9]+)?)?$"
then
	echo $OUT_VALUE
else
        G2Cp=${@:3}
       	OUT_V=4000000000
	printf "****ERROR****\nnode: %s\nInstance %s\nRandom seed: %s\n Params to g2c\n %s \n\n Params to EMILI\n %s \n OUTPUT \n %s \n **********\n\n" "${HOST_NAME}" "${INSTANCE}" "${RND_SEED}" "${G2Cp[@]}" "${PARAMETERS}" "${OUT_VALUE}" >> $ERR_OUT
	for i in `seq 1 $TRIES`
	    do	
		$EMILI_BIN $INSTANCE $PARAMETERS $TIMER_SETTING rnds $RND_SEED 1> $STDOUT 2> $STDERR
		OUT_VALUE=`cat $STDERR | tail -n1`
	    if echo "$OUT_VALUE" | grep -Eq "^[0-9]+(\.[0-9]+([eE][+-][0-9]+)?)?$"
            then
	      OUT_V=$OUT_VALUE
	      break
	    else
	      printf "****ERROR %s****\nInstance %s\nRandom seed: %s\n Params to g2c\n %s \n\n Params to EMILI\n %s \n OUTPUT \n %s \n **********\n\n" "$i" "${INSTANCE}" "${RND_SEED}" "${G2Cp[@]}" "${PARAMETERS}" "${OUT_VALUE}" >> $ERR_OUT
            fi
	done
	echo $OUT_V
fi 
popd 1>> $OUTPUT
rm -f $STDOUT
rm -f $STDERR
rm -rf $BUILD_DIR
